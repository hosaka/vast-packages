# Template file for 'noctalia'
pkgname=noctalia
version=5.0.0.beta10
revision=1
build_style=meson
build_helper=qemu
configure_args="--buildtype=release"
hostmakedepends="pkg-config git"
makedepends="MesaLib-devel basu-devel cairo-devel fontconfig-devel freetype-devel
 harfbuzz-devel jemalloc-devel json-c++ libcurl-devel libepoxy-devel libglvnd-devel
 libical-devel libjxl-devel libmd4c-devel libqalculate-devel librsvg-devel
 libsecret-devel libsndfile-devel libsodium-devel libwebp-devel libxkbcommon-devel
 libxml2-devel pam-devel pango-devel pipewire-devel polkit-devel sdbus-c++-devel stb
 tomlplusplus-devel wayland-devel wayland-protocols wireplumber-devel"
short_desc="Desktop shell built on Wayland and OpenGL ES"
maintainer="Alex March <alex@hosaka.cc>"
license="MIT"
homepage="https://github.com/noctalia-dev/noctalia"
changelog="https://github.com/noctalia-dev/noctalia/releases"
distfiles="https://github.com/noctalia-dev/noctalia/archive/refs/tags/v${version/.beta/-beta.}.tar.gz"
checksum=6386f9b56bf01e6515a3df9e4662a80a8e20ec87815cdca362af9b9c3c429be2

CXXFLAGS="-std=c++23"

do_patch() {
	local upver="${version/beta/-beta.}"
	vsed -i "0,/version: '[^']*'/s//version: '${upver}'/" meson.build
}

post_install() {
	for shell in bash fish zsh; do
		vtargetrun ${DESTDIR}/usr/bin/noctalia completions ${shell} > noctalia.${shell}
		vcompletion noctalia.${shell} ${shell}
	done

	vlicense LICENSE
}
