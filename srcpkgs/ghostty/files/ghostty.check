#!/bin/sh
# Ask the bus itself rather than messaging com.mitchellh.ghostty, which would
# activate another Ghostty instance.
dbus-send --bus="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}" \
  --print-reply=literal --dest=org.freedesktop.DBus / \
  org.freedesktop.DBus.NameHasOwner string:com.mitchellh.ghostty 2>/dev/null |
  grep -q 'boolean true'
